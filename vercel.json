{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "cleanUrls": true,
  "trailingSlash": false,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],

  "redirects": [
    { "source": "/refund", "destination": "/refunds", "permanent": false },
    { "source": "/cancellation", "destination": "/refunds", "permanent": false },
    { "source": "/cancellation-and-refunds", "destination": "/refunds", "permanent": false },
    { "source": "/refund-policy", "destination": "/refunds", "permanent": false },
    { "source": "/privacy-policy", "destination": "/privacy", "permanent": false },
    { "source": "/terms-and-conditions", "destination": "/terms", "permanent": false },
    { "source": "/terms-of-service", "destination": "/terms", "permanent": false },
    { "source": "/shipping-policy", "destination": "/shipping", "permanent": false },
    { "source": "/shipping-and-delivery", "destination": "/shipping", "permanent": false },
    { "source": "/contact-us", "destination": "/contact", "permanent": false },
    { "source": "/account-deletion", "destination": "/delete-account", "permanent": false },
    { "source": "/delete-my-account", "destination": "/delete-account", "permanent": false },
    { "source": "/data-deletion", "destination": "/delete-account", "permanent": false },
    { "source": "/delete", "destination": "/delete-account", "permanent": false }
  ]
}
